---
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a class:list={["logo", { light }]} href="/" aria-label="Fundamenta, ir al inicio">
  <svg viewBox="0 0 38 38" aria-hidden="true">
    <path d="M4 29.5 14.2 8.2h8.9L34 29.5h-7.6l-2.2-4.7H13.7l-2.1 4.7H4Z" fill="currentColor"/>
    <path d="M16.1 19.1h5.8L19 12.8l-2.9 6.3Z" fill="#ff7657"/>
  </svg>
  <span>fundamenta</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: .55rem; color: var(--ink); font: 760 1.1rem/1 var(--font-display); letter-spacing: -.03em; }
  .logo.light { color: #fffdf5; }
  svg { width: 1.9rem; height: 1.9rem; }
</style>
